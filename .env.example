# Copy to .env or configure these values in your hosting provider.
OWNER_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-a-long-random-secret
# Use the Supabase connection string in production.
DATABASE_URL=postgresql+psycopg://postgres:password@host:5432/postgres
# Used only when DATABASE_URL is omitted for local SQLite development.
DATABASE_PATH=./submissions.db
COOKIE_SECURE=true